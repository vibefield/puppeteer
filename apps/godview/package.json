{
  "name": "godview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ghosttea desktop Godview for terminal and coding-agent sessions.",
  "license": "MIT",
  "author": "James Yong",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "pnpm bundle",
    "bundle": "node build.mjs",
    "start": "pnpm bundle && electron .",
    "smoke": "pnpm bundle && electron . --smoke",
    "appearance-smoke": "pnpm bundle && node appearance-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "restore-smoke": "pnpm bundle && node restore-smoke.mjs"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.0",
    "@vibecook/puppeteer-builtin-providers": "workspace:*",
    "@vibecook/puppeteer-core": "workspace:*",
    "@vibecook/puppeteer-monitor": "workspace:*",
    "@vibecook/puppeteer-record": "workspace:*",
    "@vibecook/puppeteer-react": "workspace:*",
    "@vibecook/puppeteer-runtime": "workspace:*",
    "@vibecook/puppeteer-workspaces": "workspace:*",
    "@vibecook/ghosttea-electron": "0.9.3",
    "@vibecook/ghosttea-native-tabs": "0.9.3",
    "@vibecook/ghosttea-protocol": "0.9.3",
    "@vibecook/ghosttea-react": "0.9.3",
    "@vibecook/ghosttead": "0.9.3",
    "matter-js": "0.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vibecook/truffle": "0.7.12",
    "electron": "^43.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
