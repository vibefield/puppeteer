{
  "name": "godview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ghosttea desktop Godview for terminal and coding-agent sessions.",
  "license": "MIT",
  "author": "James Yong",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "pnpm bundle",
    "bundle": "node build.mjs",
    "start": "pnpm bundle && electron .",
    "smoke": "pnpm bundle && electron . --smoke",
    "appearance-smoke": "pnpm bundle && node appearance-smoke.mjs",
    "links-smoke": "pnpm bundle && node links-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "restore-smoke": "pnpm bundle && node restore-smoke.mjs",
    "swarm-lab": "node swarm-lab.mjs"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@vibecook/ghosttea-electron": "0.12.0",
    "@vibecook/ghosttea-native-tabs": "0.12.0",
    "@vibecook/ghosttea-protocol": "0.12.0",
    "@vibecook/ghosttea-react": "0.12.0",
    "@vibecook/ghosttead": "0.12.0",
    "@vibecook/puppeteer-builtin-providers": "workspace:*",
    "@vibecook/puppeteer-core": "workspace:*",
    "@vibecook/puppeteer-monitor": "workspace:*",
    "@vibecook/puppeteer-react": "workspace:*",
    "@vibecook/puppeteer-record": "workspace:*",
    "@vibecook/puppeteer-runtime": "workspace:*",
    "@vibecook/puppeteer-views": "workspace:*",
    "@vibecook/puppeteer-workspaces": "workspace:*",
    "matter-js": "0.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vibecook/truffle": "0.7.14",
    "@webgpu/types": "0.1.74",
    "electron": "^43.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
