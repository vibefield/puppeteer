{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vibecook-dev/puppeteer/support/verification.schema.json",
  "title": "Agent surface verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vendor",
    "vendorVersion",
    "groundTruth",
    "commit",
    "status",
    "gates",
    "platformReports",
    "replayDigest",
    "commands",
    "issues",
    "attestation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "vendor": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "vendorVersion": { "type": "string", "minLength": 1 },
    "groundTruth": {
      "type": "string",
      "pattern": "^packages/surface/vendors/[a-z][a-z0-9-]*/groundtruth\\.json$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "enum": ["passed", "failed"] },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "privacy",
        "model",
        "adapterFixtures",
        "imposter",
        "replayDiff",
        "hermetic",
        "pinnedArtifact",
        "platforms",
        "packaging",
        "documentation"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/gate" },
        "privacy": { "$ref": "#/$defs/gate" },
        "model": { "$ref": "#/$defs/gate" },
        "adapterFixtures": { "$ref": "#/$defs/gate" },
        "imposter": { "$ref": "#/$defs/gate" },
        "replayDiff": { "$ref": "#/$defs/gate" },
        "hermetic": { "$ref": "#/$defs/gate" },
        "pinnedArtifact": { "$ref": "#/$defs/gate" },
        "platforms": { "$ref": "#/$defs/gate" },
        "packaging": { "$ref": "#/$defs/gate" },
        "documentation": { "$ref": "#/$defs/gate" }
      }
    },
    "platformReports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "artifactSha256"],
        "properties": {
          "platform": { "type": "string", "minLength": 1 },
          "artifactSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "replayDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "command", "exitCode"],
        "properties": {
          "status": { "$ref": "#/$defs/gate" },
          "command": { "type": "string" },
          "exitCode": { "type": ["integer", "null"] },
          "detail": { "type": "string" }
        }
      }
    },
    "issues": { "type": "array", "items": { "type": "string" } },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "workflow",
        "workflowRef",
        "runId",
        "runAttempt",
        "evidenceDigest"
      ],
      "properties": {
        "provider": { "enum": ["github-actions", "local"] },
        "repository": { "type": ["string", "null"] },
        "workflow": { "type": ["string", "null"] },
        "workflowRef": { "type": ["string", "null"] },
        "runId": { "type": ["string", "null"] },
        "runAttempt": { "type": ["string", "null"] },
        "evidenceDigest": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "gate": { "enum": ["passed", "failed"] }
  }
}
