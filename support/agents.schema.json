{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vibecook-dev/puppeteer/support/agents.schema.json",
  "title": "Puppeteer promoted agent support",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "kind", "adapterPackage", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["vendor", "protocol"] },
          "adapterPackage": { "type": "string", "pattern": "^@vibecook/puppeteer-adapter-" },
          "persona": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "groundTruth": {
            "type": "string",
            "pattern": "^packages/surface/vendors/[a-z][a-z0-9-]*/groundtruth\\.json$"
          },
          "currentVersion": { "type": "string", "minLength": 1 },
          "candidateVersion": { "type": "string", "minLength": 1 },
          "legacyEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "version", "modelSha256", "frozenOn", "reason"],
            "properties": {
              "kind": { "const": "pre-asm-v2-baseline" },
              "version": { "type": "string", "minLength": 1 },
              "modelSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "frozenOn": { "type": "string", "format": "date" },
              "reason": { "type": "string", "minLength": 1 }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "candidateCommit",
              "groundTruth",
              "vendorVersion",
              "evidenceDigest",
              "replayDigest",
              "repository",
              "workflowRef",
              "runId",
              "runAttempt",
              "platformArtifacts"
            ],
            "properties": {
              "provider": { "const": "github-actions" },
              "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "groundTruth": { "type": "string" },
              "vendorVersion": { "type": "string", "minLength": 1 },
              "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "replayDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "repository": { "type": "string", "minLength": 1 },
              "workflowRef": { "type": "string", "minLength": 1 },
              "runId": { "type": "string", "pattern": "^\\d+$" },
              "runAttempt": { "type": "string", "pattern": "^\\d+$" },
              "platformArtifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "artifactSha256"],
                  "properties": {
                    "platform": { "type": "string", "minLength": 1 },
                    "artifactSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                }
              }
            }
          },
          "status": {
            "enum": ["verified", "legacy-verified", "baseline-pending", "unsupported", "deprecated"]
          },
          "introducedInPuppeteer": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["verified", "legacy-verified"] } } },
            "then": { "required": ["persona", "groundTruth", "currentVersion", "introducedInPuppeteer"] }
          },
          {
            "if": { "properties": { "status": { "const": "legacy-verified" } }, "required": ["status"] },
            "then": { "required": ["legacyEvidence"] }
          },
          {
            "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
            "then": { "required": ["verification"] }
          },
          {
            "if": { "required": ["candidateVersion"] },
            "then": { "required": ["groundTruth", "persona"] }
          }
        ]
      }
    }
  }
}
