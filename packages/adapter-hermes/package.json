{
  "name": "@vibecook/puppeteer-adapter-hermes",
  "version": "0.1.8",
  "type": "module",
  "description": "Hermes Agent adapter for Puppeteer: owned tui_gateway WebSocket host, native --tui attach, and structured observation.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/adapter-hermes"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:detection": "node scripts/generate-detection.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibecook/puppeteer-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vibecook/puppeteer-surface": "workspace:*",
    "@vibecook/puppeteer-testing": "workspace:*",
    "node-pty": "1.2.0-beta.15",
    "vitest": "^4.1.11"
  }
}
