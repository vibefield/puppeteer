{
  "name": "@vibecook/chopsticks-adapter-hermes",
  "version": "0.1.8",
  "type": "module",
  "description": "Hermes Agent adapter for Chopsticks: owned tui_gateway WebSocket host, native --tui attach, and structured observation.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecook-dev/chopsticks.git",
    "directory": "packages/adapter-hermes"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:detection": "node scripts/generate-detection.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibecook/chopsticks-core": "workspace:*"
  },
  "devDependencies": {
    "@vibecook/chopsticks-surface": "workspace:*",
    "@vibecook/chopsticks-testing": "workspace:*",
    "vitest": "^3.0.0"
  }
}
