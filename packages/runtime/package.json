{
  "name": "@vibefield/puppeteer-runtime",
  "version": "0.3.2",
  "type": "module",
  "description": "Unified Puppeteer agent runtime: provider registry, session lifecycle, workspace isolation, events, and action recording.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/runtime"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./spawn-through": "./src/host/spawn-through/index.ts",
    "./spawn-through/shim": "./src/host/spawn-through/shim-main.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./spawn-through": {
        "types": "./dist/host/spawn-through/index.d.ts",
        "import": "./dist/host/spawn-through/index.js"
      },
      "./spawn-through/shim": {
        "types": "./dist/host/spawn-through/shim-main.d.ts",
        "import": "./dist/host/spawn-through/shim-main.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibefield/puppeteer-core": "workspace:*",
    "@vibefield/puppeteer-record": "workspace:*",
    "@vibefield/puppeteer-workspaces": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  }
}
