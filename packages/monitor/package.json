{
  "name": "@vibefield/puppeteer-monitor",
  "version": "0.3.2",
  "type": "module",
  "description": "Transport-neutral external store for Puppeteer agent monitor snapshots and notifications.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/monitor"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./replica": "./src/replica/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./replica": {
        "types": "./dist/replica/index.d.ts",
        "import": "./dist/replica/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibefield/puppeteer-core": "workspace:*",
    "@vibefield/puppeteer-view-sdk": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
