{
  "name": "@vibecook/puppeteer-adapter-opencode",
  "version": "0.1.8",
  "type": "module",
  "description": "OpenCode adapter for Puppeteer: private serve backend, HTTP/SSE observation and control, and exact-session native TUI attach.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/adapter-opencode"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibecook/puppeteer-core": "workspace:*"
  },
  "devDependencies": {
    "@vibecook/puppeteer-surface": "workspace:*",
    "@vibecook/puppeteer-testing": "workspace:*",
    "vitest": "^3.0.0"
  }
}
