{
  "name": "@vibefield/puppeteer-adapter-pi",
  "version": "0.2.3",
  "type": "module",
  "description": "Pi adapter for Puppeteer: native TUI launch, durable session observation, and normalized agent events.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/adapter-pi"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibefield/puppeteer-core": "workspace:*",
    "@vibefield/puppeteer-native-observation": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@vibefield/puppeteer-testing": "workspace:*",
    "vitest": "^4.1.11"
  }
}
