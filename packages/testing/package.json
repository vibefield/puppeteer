{
  "name": "@vibefield/puppeteer-testing",
  "version": "0.2.3",
  "type": "module",
  "description": "Vendor-neutral test harness and AgentAdapterBinding conformance suite for Puppeteer adapters.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/testing"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./live-attestation": "./src/live-attestation.ts",
    "./live-cleanup": "./src/live-cleanup.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance.d.ts",
        "import": "./dist/conformance.js"
      },
      "./live-attestation": {
        "types": "./dist/live-attestation.d.ts",
        "import": "./dist/live-attestation.js"
      },
      "./live-cleanup": {
        "types": "./dist/live-cleanup.d.ts",
        "import": "./dist/live-cleanup.js"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "MIGRATION.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibefield/puppeteer-core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=4.1.11 <5"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
