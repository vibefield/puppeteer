  "live": {
    "method": "The repository's own isolated rig (packages/adapter-claude/src/test-support/live-model.ts): a throwaway HOME and CLAUDE_CONFIG_DIR per probe (trust and the bypass consent pre-seeded), a loopback Messages API that answers \"ok\", ANTHROPIC_AUTH_TOKEN a placeholder, nonessential traffic off, command hooks appending to a throwaway log, the session in a node-pty the harness owns. Nothing of the owner's configuration or account is read or written. <managed hooks> is a settings file whose SessionStart, UserPromptSubmit, Stop and SessionEnd command hooks log each event.",
    "prompt": "Reply with the single word ok.",
    "sessions": 16,
    "probes": [
      {
        "id": "L01",
        "question": "a prompt carried after `--` reaches the session as its first prompt; the generated hooks fire",
        "argv": [
          "--session-id",
          "<uuid>",
          "--settings",
          "<managed hooks>",
          "--permission-mode",
          "default",
          "--",
          "<prompt>"
        ],
        "exit": "hung up by the harness after Stop or its timeout",
        "hookEvents": [
          "managed:SessionStart",
          "managed:UserPromptSubmit[default]",
          "managed:Stop[default]",
          "managed:SessionEnd"
        ],
        "modelTurns": 1,
        "observed": "SessionStart (startup), UserPromptSubmit with the prompt equal to the one typed, Stop and SessionEnd, all under the managed session id; one model turn."
      },
      {
        "id": "L02",
        "question": "two --settings flags: does the second compose with the first, or replace it",
        "argv": [
          "--session-id",
          "<uuid>",
          "--settings",
          "<managed hooks>",
          "--settings",
          "<second hooks>",
          "--permission-mode",
          "default",
          "--",
          "<prompt>"
        ],
        "exit": "hung up by the harness after Stop or its timeout",
        "hookEvents": [
          "settings-B:SessionStart",
          "settings-B:UserPromptSubmit[default]",
          "settings-B:Stop[default]",
          "settings-B:SessionEnd"
        ],
        "modelTurns": 1,
        "observed": "Only the second --settings file's hooks ran; the managed hooks (first --settings) never fired. A second --settings replaces the first."
      },
      {
        "id": "L03",
        "question": "--dangerously-skip-permissions together with --permission-mode default: which mode the session is in",
        "argv": [
          "--session-id",
          "<uuid>",
          "--settings",
          "<managed hooks>",
          "--permission-mode",
          "default",
          "--dangerously-skip-permissions",
          "--",
          "<prompt>"
        ],
        "exit": "hung up by the harness after Stop or its timeout",
        "hookEvents": [
          "managed:SessionStart",
          "managed:UserPromptSubmit[bypassPermissions]",
          "managed:Stop[bypassPermissions]",
          "managed:SessionEnd"
        ],
        "modelTurns": 1,
        "observed": "permission_mode bypassPermissions: the skip flag wins over --permission-mode default."
      },
      {
        "id": "L04",
        "question": "--dangerously-skip-permissions carried, the recipe adding no permission mode",
        "argv": [
          "--session-id",
          "<uuid>",
          "--settings",
          "<managed hooks>",
          "--dangerously-skip-permissions",
          "--",
          "<prompt>"
        ],
        "exit": "hung up by the harness after Stop or its timeout",
        "hookEvents": [
          "managed:SessionStart",
          "managed:UserPromptSubmit[bypassPermissions]",
          "managed:Stop[bypassPermissions]",
          "managed:SessionEnd"
        ],
        "modelTurns": 1,
        "observed": "permission_mode bypassPermissions."
      },
      {
        "id": "L05",
        "question": "user settings defaultMode acceptEdits; typed `claude -- <prompt>` (control, user hooks observe)",
        "argv": [
