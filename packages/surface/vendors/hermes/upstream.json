{
  "$schema": "../../upstream.schema.json",
  "schemaVersion": 1,
  "vendor": "hermes",
  "repository": "https://github.com/NousResearch/hermes-agent",
  "sourceRelation": {
    "strategy": "release-tag",
    "template": "${tag}"
  },
  "detectors": [
    {
      "id": "github-stable",
      "channel": "stable",
      "kind": "github-release",
      "url": "https://api.github.com/repos/NousResearch/hermes-agent/releases?per_page=30",
      "tagPattern": "^v(\\d{4}\\.\\d{1,2}\\.\\d{1,2})$",
      "titlePattern": "v(\\d+\\.\\d+\\.\\d+)",
      "prerelease": false,
      "authoritative": true
    }
  ],
  "platforms": ["darwin-arm64", "darwin-x64", "linux-x64", "windows-x64"],
  "acquisition": {
    "strategy": "source-revision",
    "allowedHosts": ["github.com", "codeload.github.com", "objects.githubusercontent.com"],
    "maxBytes": 536870912,
    "sourceArchive": {
      "urls": [
        "https://github.com/NousResearch/hermes-agent/archive/refs/tags/${tag}.tar.gz",
        "https://codeload.github.com/NousResearch/hermes-agent/tar.gz/refs/tags/${tag}"
      ],
      "format": "tar.gz",
      "rootFiles": ["pyproject.toml", "uv.lock"],
      "maxExtractedBytes": 1073741824
    },
    "installedConsole": {
      "strategy": "python-uv-lock",
      "pythonVersion": "3.11.9",
      "uvVersion": "0.9.28",
      "projectFile": "pyproject.toml",
      "lockFile": "uv.lock",
      "distribution": "hermes-agent",
      "consoleScript": "hermes",
      "installMode": "editable",
      "generatedSourcePaths": ["hermes_agent.egg-info"],
      "versionOutput": "first-line",
      "isolatedHomeEnvironment": ["HERMES_HOME"]
    }
  },
  "analysis": [
    "source-revision",
    "cli-flags",
    "tui-gateway-jsonrpc",
    "plugin-hooks",
    "outbound-webhooks",
    "session-db",
    "acp-survey",
    "controlled-census"
  ],
  "debounce": { "polls": 2, "minutes": 30 }
}
