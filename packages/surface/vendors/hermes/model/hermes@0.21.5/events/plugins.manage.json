  "recordSchema": {
    "type": "object",
    "properties": {
      "direction": {
        "type": "string",
        "enum": ["client"]
      },
      "jsonrpc": {
        "type": "string",
        "enum": ["2.0"]
      },
      "id": {
        "type": "string"
      },
      "method": {
        "type": "string",
        "enum": ["plugins.manage"]
      },
      "params": {
        "$ref": "#/$defs/PluginsManageParams"
      }
    },
    "required": ["direction", "jsonrpc", "id", "method", "params"],
    "$defs": {
      "PluginsManageParams": {
        "additionalProperties": false,
        "description": "``toggle``: ``key``/``name`` + ``enable``; ``install``: ``identifier``/``repo`` or ``catalog_name``\n(+ ``force``, ``enable``, ``ref``); ``update``: ``name`` (+ ``accept_capabilities`` to apply a re-pin\nthat widened the plugin after the user confirmed the ``delta``); ``remove``: ``name`` (user installs only);\n``settings``: ``key`` + ``values`` (``{setting_key: value}``, non-secret schema keys only).",
        "properties": {
          "accept_capabilities": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Accept Capabilities"
          },
          "action": {
            "$ref": "#/$defs/PluginsAction",
            "default": "list"
          },
          "catalog_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Catalog Name"
          },
          "enable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Enable"
          },
          "force": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Force"
          },
          "identifier": {
