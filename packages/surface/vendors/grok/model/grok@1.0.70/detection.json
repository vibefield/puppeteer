{
  "executables": ["grok"],
  "envVar": "PUPPETEER_GROK_BIN",
  "versionFlag": "--version",
  "versionOutput": "grok 1.0.70 (f50904eaee6c)",
  "versionPattern": "^grok (\\d+\\.\\d+\\.\\d+) \\(([0-9a-f]+)\\)(?: \\[(stable|alpha)\\])?$",
  "helpFlag": "--help",
  "launchFlags": {
    "leader": "leader",
    "leaderSocket": "--leader-socket",
    "sessionId": "--session-id",
    "resume": "--resume",
    "model": "--model",
    "permissionMode": "--permission-mode",
    "sandbox": "--sandbox"
  }
}
