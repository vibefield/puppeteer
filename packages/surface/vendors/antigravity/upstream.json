{
  "$schema": "../../upstream.schema.json",
  "schemaVersion": 1,
  "vendor": "antigravity",
  "repository": "https://github.com/google-antigravity/antigravity-cli",
  "sourceRelation": {
    "strategy": "release-tag",
    "template": "${version}"
  },
  "detectors": [
    {
      "id": "github-stable",
      "channel": "stable",
      "kind": "github-release",
      "url": "https://api.github.com/repos/google-antigravity/antigravity-cli/releases?per_page=30",
      "tagPattern": "^(\\d+\\.\\d+\\.\\d+)$",
      "prerelease": false,
      "authoritative": true
    }
  ],
  "platforms": ["darwin-arm64", "darwin-x64", "linux-x64", "windows-x64"],
  "acquisition": {
    "strategy": "https-template",
    "allowedHosts": ["github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"],
    "maxBytes": 536870912,
    "artifacts": {
      "darwin-arm64": {
        "urls": [
          "https://github.com/google-antigravity/antigravity-cli/releases/download/${version}/agy_cli_mac_arm64.tar.gz"
        ],
        "format": "tar.gz",
        "executableBasenames": ["antigravity"]
      },
      "darwin-x64": {
        "urls": [
          "https://github.com/google-antigravity/antigravity-cli/releases/download/${version}/agy_cli_mac_x64.tar.gz"
        ],
        "format": "tar.gz",
        "executableBasenames": ["antigravity"]
      },
      "linux-x64": {
        "urls": [
          "https://github.com/google-antigravity/antigravity-cli/releases/download/${version}/agy_cli_linux_x64.tar.gz"
        ],
        "format": "tar.gz",
        "executableBasenames": ["antigravity"]
      },
      "windows-x64": {
        "urls": [
          "https://github.com/google-antigravity/antigravity-cli/releases/download/${version}/agy_cli_windows_x64.zip"
        ],
        "format": "zip",
        "executableBasenames": ["antigravity.exe"]
      }
    }
  },
  "analysis": [
    "binary-flags",
    "command-hooks",
    "transcript",
    "statusline",
    "conversation-resume",
    "controlled-census"
  ],
  "debounce": { "polls": 2, "minutes": 30 }
}
