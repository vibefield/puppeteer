{
  "$schema": "../../upstream.schema.json",
  "schemaVersion": 1,
  "vendor": "codex",
  "repository": "https://github.com/openai/codex",
  "sourceRelation": {
    "strategy": "release-tag",
    "template": "rust-v${version}"
  },
  "detectors": [
    {
      "id": "github-stable",
      "channel": "stable",
      "kind": "github-release",
      "url": "https://api.github.com/repos/openai/codex/releases?per_page=30",
      "tagPattern": "^rust-v(\\d+\\.\\d+\\.\\d+)$",
      "prerelease": false,
      "authoritative": true
    },
    {
      "id": "github-preview",
      "channel": "preview",
      "kind": "github-release",
      "url": "https://api.github.com/repos/openai/codex/releases?per_page=30",
      "tagPattern": "^rust-v(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+))$",
      "prerelease": true,
      "authoritative": false
    }
  ],
  "platforms": ["darwin-arm64", "darwin-x64", "linux-x64", "windows-x64"],
  "acquisition": {
    "strategy": "https-template",
    "allowedHosts": ["github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"],
    "maxBytes": 536870912,
    "artifacts": {
      "darwin-arm64": {
        "urls": [
          "https://github.com/openai/codex/releases/download/rust-v${version}/codex-package-aarch64-apple-darwin.tar.gz",
          "https://github.com/openai/codex/releases/download/rust-v${version}/codex-aarch64-apple-darwin.tar.gz"
        ],
        "format": "tar.gz",
        "executableBasenames": ["codex", "codex-aarch64-apple-darwin"]
      },
      "darwin-x64": {
        "urls": [
          "https://github.com/openai/codex/releases/download/rust-v${version}/codex-package-x86_64-apple-darwin.tar.gz",
          "https://github.com/openai/codex/releases/download/rust-v${version}/codex-x86_64-apple-darwin.tar.gz"
        ],
        "format": "tar.gz",
        "executableBasenames": ["codex", "codex-x86_64-apple-darwin"]
      },
      "linux-x64": {
        "urls": [
          "https://github.com/openai/codex/releases/download/rust-v${version}/codex-package-x86_64-unknown-linux-musl.tar.gz",
          "https://github.com/openai/codex/releases/download/rust-v${version}/codex-x86_64-unknown-linux-musl.tar.gz"
        ],
        "format": "tar.gz",
        "executableBasenames": ["codex", "codex-x86_64-unknown-linux-musl"]
      },
      "windows-x64": {
        "urls": [
          "https://github.com/openai/codex/releases/download/rust-v${version}/codex-package-x86_64-pc-windows-msvc.tar.gz"
        ],
        "format": "tar.gz",
        "executableBasenames": ["codex.exe", "codex-x86_64-pc-windows-msvc.exe"]
      }
    }
  },
  "analysis": ["binary-flags", "app-server-schema", "experimental-schema", "hermetic-provider-census"],
  "debounce": { "polls": 2, "minutes": 30 }
}
