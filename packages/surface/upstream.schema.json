{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vibecook-dev/puppeteer/packages/surface/upstream.schema.json",
  "title": "Coding-agent upstream release detector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vendor",
    "repository",
    "detectors",
    "platforms",
    "acquisition",
    "analysis",
    "debounce"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "vendor": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "repository": { "type": "string", "format": "uri" },
    "sourceRelation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "template"],
          "properties": {
            "strategy": { "const": "release-tag" },
            "template": {
              "type": "string",
              "pattern": "\\$\\{(?:version|tag)\\}"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "path"],
          "properties": {
            "strategy": { "const": "source-revision-file" },
            "path": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$" }
          }
        }
      ]
    },
    "detectors": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acquisition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "allowedHosts", "maxBytes", "artifacts"],
          "properties": {
            "strategy": { "const": "https-template" },
            "versionOutput": { "enum": ["single-line", "copilot-cli"] },
            "allowedHosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "artifacts": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["urls", "format", "executableBasenames"],
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^https://.*\\$\\{version\\}" }
                  },
                  "format": { "enum": ["binary", "tar.gz", "zip"] },
                  "bundle": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["entry", "rootFiles", "maxExtractedBytes"],
                    "properties": {
                      "entry": { "type": "string", "minLength": 1 },
                      "rootFiles": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                      "maxExtractedBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
                    }
                  },
                  "executableBasenames": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$" }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "allowedHosts", "maxBytes", "sourceArchive", "installedConsole"],
          "properties": {
            "strategy": { "const": "source-revision" },
            "allowedHosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "sourceArchive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["urls", "format", "rootFiles", "maxExtractedBytes"],
              "properties": {
                "urls": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^https://.*\\$\\{(?:version|tag)\\}"
                  }
                },
                "format": { "enum": ["tar.gz", "zip"] },
                "rootFiles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                  }
                },
                "maxExtractedBytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 }
              }
            },
            "installedConsole": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy",
                "pythonVersion",
                "uvVersion",
                "projectFile",
                "lockFile",
                "distribution",
                "consoleScript",
                "installMode",
                "generatedSourcePaths",
                "versionOutput",
                "isolatedHomeEnvironment"
              ],
              "properties": {
                "strategy": { "const": "python-uv-lock" },
                "pythonVersion": { "type": "string", "pattern": "^3\\.\\d+\\.\\d+$" },
                "uvVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
                "projectFile": {
                  "type": "string",
                  "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                },
                "lockFile": {
                  "type": "string",
                  "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                },
                "distribution": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$" },
                "consoleScript": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$" },
                "installMode": { "enum": ["editable", "non-editable"] },
                "generatedSourcePaths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                  }
                },
                "versionOutput": { "enum": ["single-line", "first-line"] },
                "isolatedHomeEnvironment": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$",
                    "not": {
                      "enum": [
                        "CARGO_ENCODED_RUSTFLAGS",
                        "RUSTFLAGS",
                        "SOURCE_DATE_EPOCH",
                        "COMSPEC",
                        "HOME",
                        "HTTP_PROXY",
                        "HTTPS_PROXY",
                        "LANG",
                        "LC_ALL",
                        "NO_COLOR",
                        "NO_PROXY",
                        "PATH",
                        "PATHEXT",
                        "PYTHONDONTWRITEBYTECODE",
                        "SSL_CERT_DIR",
                        "SSL_CERT_FILE",
                        "SYSTEMROOT",
                        "SystemRoot",
                        "TEMP",
                        "TMP",
                        "TMPDIR",
                        "USERPROFILE",
                        "UV_NO_ENV_FILE",
                        "UV_NO_PYTHON_DOWNLOADS",
                        "UV_PROJECT_ENVIRONMENT",
                        "WINDIR"
                      ]
                    }
                  }
                },
                "dependencyBuilds": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "darwin-x64": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "strategy",
                        "sourceDateEpoch",
                        "distribution",
                        "version",
                        "sbom",
                        "normalizedRoot"
                      ],
                      "properties": {
                        "strategy": {
                          "const": "rust-cyclonedx-v1"
                        },
                        "sourceDateEpoch": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4102444800
                        },
                        "distribution": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "version": {
                          "type": "string",
                          "pattern": "^\\d+\\.\\d+\\.\\d+$"
                        },
                        "sbom": {
                          "type": "string",
                          "pattern": "^sboms/[A-Za-z0-9_-]+\\.cyclonedx\\.json$"
                        },
                        "normalizedRoot": {
                          "type": "string",
                          "pattern": "^/[a-z][a-z0-9-]*$"
                        }
                      }
                    }
                  }
                },
                "runtimeBundle": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "strategy",
                    "nodeVersion",
                    "npmVersion",
                    "packageFile",
                    "lockFile",
                    "workspace",
                    "workspacePackageFile",
                    "buildFile",
                    "outputFile",
                    "environmentVariable",
                    "maxBytes"
                  ],
                  "properties": {
                    "strategy": { "const": "node-npm-lock-bundle" },
                    "nodeVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
                    "npmVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
                    "packageFile": {
                      "type": "string",
                      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                    },
                    "lockFile": {
                      "type": "string",
                      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                    },
                    "workspace": {
                      "type": "string",
                      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                    },
                    "workspacePackageFile": {
                      "type": "string",
                      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                    },
                    "buildFile": {
                      "type": "string",
                      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                    },
                    "outputFile": {
                      "type": "string",
                      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                    },
                    "environmentVariable": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]*$",
                      "not": {
                        "enum": [
                          "COMSPEC",
                          "HOME",
                          "HTTP_PROXY",
                          "HTTPS_PROXY",
                          "LANG",
                          "LC_ALL",
                          "NO_COLOR",
                          "NO_PROXY",
                          "PATH",
                          "PATHEXT",
                          "SSL_CERT_DIR",
                          "SSL_CERT_FILE",
                          "SYSTEMROOT",
                          "SystemRoot",
                          "TEMP",
                          "TMP",
                          "TMPDIR",
                          "USERPROFILE",
                          "WINDIR"
                        ]
                      }
                    },
                    "maxBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "analysis": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "debounce": {
      "type": "object",
      "required": ["polls", "minutes"],
      "properties": {
        "polls": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
