{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vibecook-dev/chopsticks/packages/surface/upstream.schema.json",
  "title": "Coding-agent upstream release detector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vendor",
    "repository",
    "detectors",
    "platforms",
    "acquisition",
    "analysis",
    "debounce"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "vendor": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "repository": { "type": "string", "format": "uri" },
    "sourceRelation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "template"],
          "properties": {
            "strategy": { "const": "release-tag" },
            "template": {
              "type": "string",
              "pattern": "\\$\\{(?:version|tag)\\}"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "path"],
          "properties": {
            "strategy": { "const": "source-revision-file" },
            "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          }
        }
      ]
    },
    "detectors": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acquisition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "allowedHosts", "maxBytes", "artifacts"],
          "properties": {
            "strategy": { "const": "https-template" },
            "allowedHosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "artifacts": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["urls", "format", "executableBasenames"],
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^https://.*\\$\\{version\\}" }
                  },
                  "format": { "enum": ["binary", "tar.gz", "zip"] },
                  "executableBasenames": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "allowedHosts", "maxBytes", "sourceArchive"],
          "properties": {
            "strategy": { "const": "source-revision" },
            "allowedHosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "sourceArchive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["urls", "format", "executableBasenames"],
              "properties": {
                "urls": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^https://.*\\$\\{(?:version|tag)\\}"
                  }
                },
                "format": { "enum": ["tar.gz", "zip"] },
                "executableBasenames": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
                }
              }
            }
          }
        }
      ]
    },
    "analysis": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "debounce": {
      "type": "object",
      "required": ["polls", "minutes"],
      "properties": {
        "polls": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
