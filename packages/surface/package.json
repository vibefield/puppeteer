{
  "name": "@vibefield/puppeteer-surface",
  "version": "0.2.1",
  "type": "module",
  "description": "Vendor-neutral evidence and Agent Surface Model (ASM) runtime for captured coding-agent behavior.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/surface"
  },
  "main": "./src/model.ts",
  "types": "./src/model.ts",
  "exports": {
    ".": "./src/model.ts",
    "./package.json": "./package.json",
    "./sanitize": "./src/sanitize.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/model.js",
    "types": "./dist/model.d.ts",
    "exports": {
      ".": {
        "types": "./dist/model.d.ts",
        "import": "./dist/model.js"
      },
      "./package.json": "./package.json",
      "./sanitize": {
        "types": "./dist/sanitize.d.ts",
        "import": "./dist/sanitize.js"
      }
    }
  },
  "files": [
    "dist",
    "vendors/*/groundtruth.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "surface:audit": "node scripts/audit.mjs",
    "surface:groundtruth:check": "node scripts/groundtruth.mjs check",
    "surface:groundtruth:write": "node scripts/groundtruth.mjs build",
    "surface:groundtruth:render": "node scripts/groundtruth.mjs render",
    "surface:evidence:check": "node scripts/check-evidence.mjs",
    "surface:evidence:write": "node scripts/check-evidence.mjs --write && node scripts/groundtruth.mjs build",
    "surface:workflow:check": "node scripts/workflow.mjs",
    "surface:audit:antigravity": "node vendors/antigravity/audit.mjs",
    "surface:audit:copilot": "node vendors/copilot/audit.mjs",
    "surface:audit:pi": "node vendors/pi/audit.mjs",
    "surface:audit:claude": "node vendors/claude/audit.mjs",
    "surface:audit:codex": "node vendors/codex/audit.mjs",
    "surface:audit:grok": "node vendors/grok/audit.mjs",
    "surface:reference:grok": "node vendors/grok/census/extract-public-reference.mjs",
    "surface:sanitize:grok": "node vendors/grok/sanitize-captures.mjs",
    "surface:privacy:grok": "node vendors/grok/sanitize-captures.mjs --check",
    "surface:audit:hermes": "node vendors/hermes/audit.mjs",
    "surface:audit:kimi": "node vendors/kimi/audit.mjs",
    "surface:audit:opencode": "node vendors/opencode/audit.mjs",
    "surface:census:antigravity": "node scripts/import-rosetta.mjs antigravity",
    "surface:census:antigravity:extras": "node vendors/antigravity/census/harness.mjs --mode offline --extras",
    "surface:census:antigravity:authorized": "node vendors/antigravity/census/authorized-census.mjs",
    "surface:model:antigravity": "node vendors/antigravity/census/generate-model.mjs",
    "surface:sanitize:antigravity": "node vendors/antigravity/sanitize-captures.mjs",
    "surface:privacy:antigravity": "node vendors/antigravity/sanitize-captures.mjs --check",
    "surface:census:copilot": "node scripts/import-rosetta.mjs copilot",
    "surface:model:copilot": "node vendors/copilot/census/generate-model.mjs",
    "surface:sanitize:copilot": "node vendors/copilot/sanitize-captures.mjs",
    "surface:privacy:copilot": "node vendors/copilot/sanitize-captures.mjs --check",
    "surface:census:pi": "node scripts/import-rosetta.mjs pi",
    "surface:model:pi": "node vendors/pi/census/generate-model.mjs",
    "surface:sanitize:pi": "node vendors/pi/sanitize-captures.mjs",
    "surface:privacy:pi": "node vendors/pi/sanitize-captures.mjs --check",
    "surface:census:claude": "node vendors/claude/census/harness.mjs",
    "surface:census:claude:invocation": "node vendors/claude/census/invocation-probes.mjs",
    "surface:census:claude:switches": "node vendors/claude/census/switch-probes.mjs",
    "surface:model:claude": "node vendors/claude/census/generate-model.mjs",
    "surface:census:codex": "node vendors/codex/census/harness.mjs",
    "surface:sanitize:codex": "node vendors/codex/census/sanitize.mjs",
    "surface:privacy:codex": "node vendors/codex/census/sanitize.mjs --check-only",
    "surface:census:hermes": "node vendors/hermes/census/harness.mjs",
    "surface:reference:hermes": "node vendors/hermes/census/extract-source-reference.mjs",
    "surface:model:hermes": "node vendors/hermes/census/generate-model.mjs",
    "surface:model:grok": "node vendors/grok/census/generate-model.mjs",
    "surface:sanitize:hermes": "node vendors/hermes/sanitize-captures.mjs",
    "surface:privacy:hermes": "node vendors/hermes/sanitize-captures.mjs --check",
    "surface:census:kimi": "node vendors/kimi/census/harness.mjs",
    "surface:probe:kimi": "node vendors/kimi/census/probe-binary.mjs",
    "surface:reference:kimi": "node vendors/kimi/census/extract-source-reference.mjs",
    "surface:census:opencode": "node vendors/opencode/census/harness.mjs",
    "surface:sanitize:kimi": "node vendors/kimi/sanitize-captures.mjs",
    "surface:privacy:kimi": "node vendors/kimi/sanitize-captures.mjs --check",
    "surface:model:kimi": "node vendors/kimi/census/generate-model.mjs",
    "surface:model:codex": "node vendors/codex/census/generate-model.mjs",
    "surface:model:opencode": "node vendors/opencode/census/generate-model.mjs --version 1.18.16",
    "surface:privacy:claude": "node vendors/claude/sanitize-captures.mjs --check",
    "surface:sanitize:claude": "node vendors/claude/sanitize-captures.mjs",
    "surface:privacy:opencode": "node vendors/opencode/census/sanitize.mjs --version 1.18.16 --check-only",
    "surface:sanitize:opencode": "node vendors/opencode/census/sanitize.mjs --version 1.18.16"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
