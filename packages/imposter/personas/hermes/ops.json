{
  "session.start": [
    {
      "channel": "jsonrpc",
      "event": "gateway.ready",
      "with": {
        "skin": {},
        "change_events": true,
        "replay_epoch": "$uuid:replay-epoch"
      }
    },
    {
      "channel": "hook",
      "event": "on_session_start",
      "with": {
        "session_id": "$storedSessionId",
        "model": "puppeteer-hermes-census",
        "platform": "tui"
      }
    }
  ],
  "session.ready": [
    {
      "channel": "jsonrpc",
      "event": "session.info",
      "with": {
        "model": "puppeteer-hermes-census",
        "provider": "custom",
        "approval_mode": "manual",
        "version": "0.21.5",
        "cwd": "$cwd",
        "stored_session_id": "$storedSessionId",
        "running": false
      }
    }
  ],
  "session.end": [
    {
      "channel": "hook",
      "event": "on_session_end",
      "with": {
        "session_id": "$storedSessionId",
        "completed": true,
        "interrupted": false,
        "platform": "tui"
      }
    },
    {
      "channel": "hook",
      "event": "on_session_finalize",
      "with": {
        "session_id": "$storedSessionId",
        "platform": "tui"
      }
    }
  ],
  "turn.start": [
    {
      "channel": "jsonrpc",
      "event": "message.start",
      "with": {}
    },
    {
      "channel": "hook",
      "event": "pre_llm_call",
      "with": {
        "session_id": "$storedSessionId",
        "user_message": "$op.text",
        "platform": "tui"
      }
    }
  ],
  "assistant.delta": [
    {
      "channel": "jsonrpc",
      "event": "thinking.delta",
      "with": {
        "text": "(⊙_⊙) pondering..."
      }
    },
    {
      "channel": "jsonrpc",
      "event": "message.delta",
      "with": {
        "text": "$op.text"
      }
    }
  ],
  "tool.start": [
    {
      "channel": "jsonrpc",
      "event": "tool.generating",
      "with": {
        "name": "$op.tool"
      }
    },
    {
      "channel": "jsonrpc",
      "event": "tool.start",
      "with": {
        "name": "$op.tool",
        "tool_id": "$op.toolId",
        "context": "agent"
      }
    },
    {
      "channel": "hook",
      "event": "pre_tool_call",
      "with": {
        "session_id": "$storedSessionId",
        "tool_name": "$op.tool",
        "tool_call_id": "$op.toolId",
        "args": {}
      }
    }
  ],
  "tool.end": [
    {
      "channel": "jsonrpc",
      "event": "tool.complete",
      "with": {
        "name": "$op.tool",
        "tool_id": "$op.toolId",
        "args": {},
        "result": "$op.result"
      }
    },
    {
      "channel": "hook",
      "event": "post_tool_call",
      "with": {
        "session_id": "$storedSessionId",
        "tool_name": "$op.tool",
        "tool_call_id": "$op.toolId",
        "args": {},
        "status": "$op.status"
      }
    }
  ],
  "permission.ask": [
    {
      "channel": "hook",
      "event": "pre_approval_request",
      "with": {
        "session_id": "$storedSessionId",
        "session_key": "$storedSessionId",
        "surface": "gateway",
        "command": "rm -rf ./scratch",
        "description": "delete in root path",
        "pattern_key": "delete in root path",
        "pattern_keys": ["delete in root path"]
      }
    },
    {
      "channel": "jsonrpc",
      "event": "approval",
      "await": true,
      "with": {
        "session_id": "$liveSessionId",
        "request_id": "$uuid:approval",
        "command": "rm -rf ./scratch",
        "description": "delete in root path",
        "pattern_key": "delete in root path",
        "pattern_keys": ["delete in root path"],
        "allow_permanent": true,
        "allow_session": true,
        "choices": ["once", "session", "always", "deny"]
      }
    }
  ],
  "turn.end": [
    {
      "channel": "jsonrpc",
      "event": "reasoning.available",
      "with": {
        "text": "$reply"
      }
    },
    {
      "channel": "jsonrpc",
      "event": "message.complete",
      "with": {
        "text": "$reply",
        "status": "complete",
        "usage": {
          "model": "puppeteer-hermes-census",
          "input": 24,
          "output": 6,
          "reasoning": 0,
          "prompt": 24,
          "completion": 6,
          "total": 30,
          "calls": 1
        }
      }
    },
    {
      "channel": "hook",
      "event": "post_llm_call",
      "with": {
        "session_id": "$storedSessionId",
        "assistant_response": "$reply",
        "platform": "tui"
      }
    }
  ],
  "usage.refresh": [
    {
      "channel": "jsonrpc",
      "event": "session.info",
      "with": {
        "model": "puppeteer-hermes-census",
        "provider": "custom",
        "approval_mode": "manual",
        "version": "0.21.5",
        "cwd": "$cwd",
        "stored_session_id": "$storedSessionId",
        "running": false,
        "usage": {
          "model": "puppeteer-hermes-census",
          "input": 24,
          "output": 6,
          "reasoning": 0,
          "prompt": 24,
          "completion": 6,
          "total": 30,
          "calls": 1
        }
      }
    }
  ]
}
