{
  "vendor": "hermes",
  "asm": {
    "package": "@vibefield/puppeteer-surface",
    "path": "vendors/hermes"
  },
  "shimNames": ["hermes"],
  "jsonrpcEventMethod": "event",
  "envelope": {},
  "bindings": {
    "$liveSessionId": "$uuid:live",
    "$storedSessionId": "$uuid:stored"
  },
  "boot": [{ "op": "session.start" }, { "op": "session.ready" }]
}
