{
  "name": "permission-deny",
  "steps": [
    {
      "at": 0,
      "do": {
        "emit": {
          "channel": "tui-gateway",
          "event": "tool.start",
          "with": { "name": "terminal", "tool_id": "call_imposter", "context": "agent" }
        }
      }
    },
    {
      "at": 20,
      "do": {
        "emit": {
          "channel": "tui-gateway",
          "event": "approval.request",
          "with": { "choices": ["once", "session", "always", "deny"] }
        }
      }
    },
    {
      "at": 40,
      "do": {
        "emit": {
          "channel": "tui-gateway",
          "event": "tool.complete",
          "with": {
            "name": "terminal",
            "tool_id": "call_imposter",
            "args": {},
            "result": {
              "exit_code": -1,
              "status": "blocked",
              "error": "Command blocked by user; do not retry."
            }
          }
        }
      }
    },
    {
      "at": 60,
      "do": {
        "emit": {
          "channel": "tui-gateway",
          "event": "message.complete",
          "with": { "text": "permission denied", "status": "complete" }
        }
      }
    }
  ]
}
