{
  "name": "out-of-order",
  "steps": [
    {
      "emit": {
        "event": "message.part.updated",
        "with": {
          "sessionID": "$sessionId",
          "part": {
            "id": "$uuid:part",
            "messageID": "$uuid:user",
            "sessionID": "$sessionId",
            "type": "text",
            "text": "part before owner"
          },
          "time": "$nowMs"
        }
      }
    },
    {
      "emit": {
        "event": "message.updated",
        "with": {
          "sessionID": "$sessionId",
          "info": {
            "id": "$uuid:user",
            "role": "user",
            "sessionID": "$sessionId",
            "time": { "created": "$nowMs" },
            "agent": "build",
            "model": { "providerID": "imposter", "modelID": "opencode-imposter" }
          }
        }
      }
    }
  ]
}
