{
  "name": "permission-allow",
  "steps": [
    {
      "emit": {
        "event": "permission.asked",
        "request": true,
        "with": {
          "id": "$nativeId:per:permission",
          "sessionID": "$sessionId",
          "permission": "bash",
          "patterns": ["echo imposter"],
          "metadata": {
            "command": "echo imposter"
          },
          "always": ["echo *"]
        }
      }
    },
    {
      "emit": {
        "event": "permission.replied",
        "with": {
          "sessionID": "$sessionId",
          "requestID": "$nativeId:per:permission",
          "reply": "once"
        }
      }
    }
  ]
}
