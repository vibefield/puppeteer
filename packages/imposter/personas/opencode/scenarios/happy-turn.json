{
  "name": "happy-turn",
  "steps": [
    { "emit": { "event": "session.status", "with": { "sessionID": "$sessionId", "status": { "type": "busy" } } } },
    {
      "emit": {
        "event": "message.updated",
        "with": {
          "sessionID": "$sessionId",
          "info": {
            "id": "$uuid:assistant",
            "parentID": "$uuid:user",
            "role": "assistant",
            "mode": "build",
            "agent": "build",
            "path": { "cwd": "$cwd", "root": "$cwd" },
            "cost": 0,
            "tokens": { "input": 0, "output": 0, "reasoning": 0, "cache": { "read": 0, "write": 0 } },
            "modelID": "opencode-imposter",
            "providerID": "imposter",
            "time": { "created": "$nowMs" },
            "sessionID": "$sessionId"
          }
        }
      }
    },
    {
      "emit": {
        "event": "message.part.updated",
        "with": {
          "sessionID": "$sessionId",
          "part": {
            "id": "$uuid:text",
            "messageID": "$uuid:assistant",
            "sessionID": "$sessionId",
            "type": "text",
            "text": "imposter: ok"
          },
          "time": "$nowMs"
        }
      }
    },
    { "emit": { "event": "session.status", "with": { "sessionID": "$sessionId", "status": { "type": "idle" } } } },
    { "emit": { "event": "session.idle", "with": { "sessionID": "$sessionId" } } }
  ]
}
