{
  "name": "failure",
  "steps": [
    {
      "emit": {
        "event": "session.error",
        "with": {
          "sessionID": "$sessionId",
          "error": {
            "name": "UnknownError",
            "data": {
              "message": "controlled imposter failure"
            }
          }
        }
      }
    },
    {
      "emit": {
        "event": "session.status",
        "with": {
          "sessionID": "$sessionId",
          "status": {
            "type": "idle"
          }
        }
      }
    }
  ]
}
