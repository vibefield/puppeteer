{
  "name": "permission-deny",
  "steps": [
    {
      "emit": {
        "event": "permission.asked",
        "request": true,
        "with": {
          "id": "$nativeId:per:permission",
          "sessionID": "$sessionId",
          "permission": "bash",
          "patterns": ["rm unsafe"],
          "metadata": {
            "command": "rm unsafe"
          },
          "always": []
        }
      }
    },
    {
      "emit": {
        "event": "permission.replied",
        "with": {
          "sessionID": "$sessionId",
          "requestID": "$nativeId:per:permission",
          "reply": "reject"
        }
      }
    }
  ]
}
