{
  "vendor": "claude",
  "asm": {
    "package": "@vibefield/puppeteer-surface",
    "path": "vendors/claude"
  },
  "shimNames": ["claude"],
  "envelope": {
    "session_id": "$sessionId",
    "transcript_path": "$transcriptPath",
    "cwd": "$cwd",
    "permission_mode": "$permissionMode"
  },
  "eventNameField": "hook_event_name",
  "boot": [
    {
      "op": "session.start",
      "with": {
        "source": "startup"
      }
    },
    {
      "op": "session.ready"
    },
    {
      "op": "usage.refresh"
    }
  ],
  "resumeBoot": [
    {
      "op": "session.start",
      "with": {
        "source": "resume",
        "seconds_since_last_response": 19,
        "context_tokens": 3005,
        "prompt_cache_likely_expired": true,
        "estimated_cache_write_usd": 0.0113
      }
    },
    {
      "op": "session.ready"
    },
    {
      "op": "usage.refresh"
    }
  ]
}
