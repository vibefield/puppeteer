{
  "vendor": "claude",
  "asm": {
    "package": "@vibecook/puppeteer-surface",
    "path": "vendors/claude"
  },
  "shimNames": [
    "claude"
  ],
  "envelope": {
    "session_id": "$sessionId",
    "transcript_path": "$transcriptPath",
    "cwd": "$cwd",
    "permission_mode": "$permissionMode"
  },
  "eventNameField": "hook_event_name",
  "boot": [
    {
      "op": "session.start",
      "with": {
        "source": "startup"
      }
    },
    {
      "op": "session.ready"
    },
    {
      "op": "usage.refresh"
    }
  ]
}
