{
  "name": "approval-turn",
  "reply": "imposter: approved",
  "ops": [
    {
      "op": "turn.start",
      "with": {
        "text": "$stimulus.text"
      }
    },
    {
      "op": "tool.start",
      "with": {
        "toolId": "$uuid:tool",
        "command": "echo ok > imposter-approval.txt"
      }
    },
    {
      "op": "permission.ask",
      "with": {
        "toolId": "$uuid:tool",
        "command": "echo ok > imposter-approval.txt"
      }
    },
    {
      "op": "tool.end",
      "with": {
        "toolId": "$uuid:tool",
        "command": "echo ok > imposter-approval.txt",
        "output": "ok"
      }
    },
    {
      "op": "assistant.delta",
      "with": {
        "text": "$reply"
      }
    },
    {
      "op": "turn.end"
    }
  ]
}
