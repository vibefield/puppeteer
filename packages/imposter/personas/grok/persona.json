{
  "vendor": "grok",
  "asm": {
    "package": "@vibefield/puppeteer-surface",
    "path": "vendors/grok"
  },
  "shimNames": ["grok"],
  "envelope": {},
  "bindings": {
    "$threadCwd": "$cwd",
    "$sessionCreatedAt": "$now",
    "$agentId": "$uuid:agent-id",
    "$attemptId": "$uuid:attempt-id"
  },
  "nativeStore": {
    "rootEnv": "GROK_HOME",
    "sessionPath": ["sessions", "$encodeURIComponent:$threadCwd", "$sessionId"],
    "updatesFile": "updates.jsonl",
    "recordTimestamp": { "field": "timestamp", "format": "epoch-seconds" },
    "recordEventId": { "metaField": "eventId" },
    "replayMeta": { "isReplay": true }
  },
  "boot": [
    { "op": "session.initialize" },
    { "op": "session.start" },
    { "op": "session.ready" },
    {
      "op": "usage.refresh",
      "with": { "usedTokens": 0 }
    }
  ]
}
