{
  "name": "duplicate-out-of-order",
  "steps": [
    {
      "at": 0,
      "do": {
        "emit": {
          "channel": "wire",
          "event": "context.append_loop_event",
          "with": {
            "event": {
              "type": "tool.result",
              "parentUuid": "$uuid:tool-event",
              "toolCallId": "call-reordered",
              "result": { "output": "early" }
            }
          }
        }
      }
    },
    {
      "at": 20,
      "do": {
        "emit": {
          "channel": "wire",
          "event": "context.append_loop_event",
          "with": {
            "event": {
              "type": "tool.call",
              "uuid": "$uuid:tool-event",
              "turnId": "0",
              "step": 1,
              "stepUuid": "$uuid:step",
              "toolCallId": "call-reordered",
              "name": "Bash",
              "args": { "command": "printf reordered" }
            }
          }
        }
      }
    },
    {
      "at": 40,
      "do": {
        "emit": {
          "channel": "wire",
          "event": "context.append_loop_event",
          "with": {
            "event": {
              "type": "tool.result",
              "parentUuid": "$uuid:tool-event",
              "toolCallId": "call-reordered",
              "result": { "output": "early" }
            }
          }
        }
      }
    }
  ]
}
