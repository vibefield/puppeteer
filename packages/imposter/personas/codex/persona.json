{
  "vendor": "codex",
  "asm": {
    "package": "@vibecook/puppeteer-surface",
    "path": "vendors/codex"
  },
  "shimNames": ["codex"],
  "envelope": {},

  "bindings": {
    "$threadId": "$uuid:thread",
    "$threadCwd": "$cwd",
    "$threadModel": "$modelId",
    "$threadModelProvider": "imposter",
    "$threadApprovalPolicy": "on-request",
    "$threadApprovalsReviewer": "user",
    "$threadCreatedAt": "$nowSeconds",
    "$threadUpdatedAt": "$nowSeconds",
    "$clientUserMessageId": null,
    "$threadSandbox": {
      "type": "workspaceWrite",
      "writableRoots": [],
      "networkAccess": false,
      "excludeTmpdirEnvVar": false,
      "excludeSlashTmp": false
    }
  },

  "nativeStore": {
    "sessionPath": ["threads", "$threadId"],
    "updatesFile": "notifications.jsonl",
    "mirrorJsonRpc": true
  },

  "boot": [{ "op": "session.start" }, { "op": "session.ready" }]
}
