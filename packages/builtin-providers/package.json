{
  "name": "@vibefield/puppeteer-builtin-providers",
  "version": "0.3.1",
  "type": "module",
  "description": "Optional turn-key composition of the Puppeteer runtime and official agent adapters.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/builtin-providers"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vibefield/puppeteer-adapter-acp": "workspace:*",
    "@vibefield/puppeteer-adapter-antigravity": "workspace:*",
    "@vibefield/puppeteer-adapter-claude": "workspace:*",
    "@vibefield/puppeteer-adapter-codex": "workspace:*",
    "@vibefield/puppeteer-adapter-copilot": "workspace:*",
    "@vibefield/puppeteer-adapter-grok": "workspace:*",
    "@vibefield/puppeteer-adapter-hermes": "workspace:*",
    "@vibefield/puppeteer-adapter-kimi": "workspace:*",
    "@vibefield/puppeteer-adapter-opencode": "workspace:*",
    "@vibefield/puppeteer-adapter-pi": "workspace:*",
    "@vibefield/puppeteer-core": "workspace:*",
    "@vibefield/puppeteer-runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
