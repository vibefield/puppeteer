{
  "name": "@vibecook/puppeteer-adapter-claude",
  "version": "0.1.8",
  "type": "module",
  "description": "Claude Code native adapter: hook registry, loopback hook bridge, event normalizer, settings generation.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecook-dev/puppeteer.git",
    "directory": "packages/adapter-claude"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:projections": "node scripts/generate-registry.mjs",
    "generate:registry": "node scripts/generate-registry.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibecook/puppeteer-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vibecook/puppeteer-surface": "workspace:*",
    "@vibecook/puppeteer-testing": "workspace:*",
    "node-pty": "1.2.0-beta.15"
  }
}
