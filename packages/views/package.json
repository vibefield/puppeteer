{
  "name": "@vibefield/puppeteer-views",
  "version": "0.3.1",
  "type": "module",
  "description": "Godview's monitor views for Puppeteer agents: the swarm on WebGPU, the list, the rain, the timeline, the instrument bar, the usage column and the find sheet, host-agnostic behind injected ports.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git",
    "directory": "packages/views"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./physics": "./src/views/swarm/physics/index.ts",
    "./deck": "./src/deck/index.ts",
    "./launcher": "./src/launcher/index.ts",
    "./lab": "./src/views/swarm/lab/main.ts",
    "./styles/views.css": "./src/styles/views.css",
    "./styles/lab.css": "./src/views/swarm/lab/lab.css",
    "./styles/deck-frame.css": "./src/styles/deck-frame.css",
    "./styles/pane-launcher.css": "./src/styles/pane-launcher.css"
  },
  "sideEffects": [
    "*.css",
    "./src/views/swarm/lab/main.ts",
    "./dist/views/swarm/lab/main.js"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./physics": {
        "types": "./dist/views/swarm/physics/index.d.ts",
        "import": "./dist/views/swarm/physics/index.js"
      },
      "./deck": {
        "types": "./dist/deck/index.d.ts",
        "import": "./dist/deck/index.js"
      },
      "./launcher": {
        "types": "./dist/launcher/index.d.ts",
        "import": "./dist/launcher/index.js"
      },
      "./lab": {
        "types": "./dist/views/swarm/lab/main.d.ts",
        "import": "./dist/views/swarm/lab/main.js"
      },
      "./styles/views.css": "./dist/styles/views.css",
      "./styles/lab.css": "./dist/views/swarm/lab/lab.css",
      "./styles/deck-frame.css": "./dist/styles/deck-frame.css",
      "./styles/pane-launcher.css": "./dist/styles/pane-launcher.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibefield/puppeteer-core": "workspace:*",
    "@vibefield/puppeteer-react": "workspace:*",
    "@vibefield/puppeteer-view-sdk": "workspace:*",
    "@webgpu/types": "0.1.72",
    "matter-js": "0.19.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "21.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vitest": "^4.1.11"
  }
}
