  "parser": {
    "library": "effect/cli 4.0.6",
    "longEquals": "--name=value and -n=value attach inline",
    "shortClusters": "-abc lexes as -a -b -c",
    "booleans": "a boolean flag takes an inline value, or consumes a following literal true/false/yes/no/y/n/on/off/1/0; --no-<name> negates it",
    "values": "a value flag consumes only the next non-option token; an option-like next token is a missing value",
    "endOfOptions": "`--` ends option parsing; the rest are operands",
    "builtIns": "--help/-h, --version/-v and --completions are extracted before command parsing, so they win anywhere in argv, even after an unknown flag or where a value was expected",
