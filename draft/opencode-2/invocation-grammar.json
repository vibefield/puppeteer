  "draftGrammar": {
    "$comment": "Shape follows NativeInvocationGrammar in packages/core/src/services/invocation-arguments.ts so the 2.x adapter can adopt it after review. Classifications are proposals. Core reads this grammar more narrowly than effect/cli parses argv: see coreDivergences before adopting it.",
    "booleanEquals": true,
    "booleanValues": true,
    "shortClusters": false,
    "optionLikeValues": false,
    "equals": true,
    "deferUtilityOptions": false,
    "options": [
      {
        "names": ["--help", "-h"],
        "arity": "none",
        "passthrough": "utility"
      },
      {
        "names": ["--version", "-v"],
        "arity": "none",
        "passthrough": "utility"
      },
      {
        "names": ["--completions"],
        "arity": "one",
        "passthrough": "utility"
      },
      {
        "names": ["--session", "-s"],
        "arity": "one",
        "mapped": "--session"
      },
      {
        "names": ["--server"],
        "arity": "one",
        "reason": "Puppeteer supplies --server for its own private backend; a user-supplied server cannot be preserved"
      },
      {
        "names": ["--standalone"],
        "arity": "none",
        "reason": "the managed launch cannot preserve this option"
      },
      {
        "names": ["--continue", "-c"],
        "arity": "none",
        "reason": "the managed launch cannot preserve this option"
      },
      {
        "names": ["--auto"],
        "arity": "none",
        "reason": "the managed launch cannot preserve this option"
      },
      {
        "names": ["--prompt"],
        "arity": "one",
        "reason": "the managed launch cannot preserve this option"
      },
      {
        "names": ["--wizard"],
        "arity": "none",
        "reason": "the managed launch cannot preserve this option"
      },
      {
        "names": ["--log-level"],
        "arity": "one",
        "reason": "the managed launch cannot preserve this option"
      },
      {
        "names": ["--print-logs"],
        "arity": "none",
        "reason": "the managed launch cannot preserve this option"
      },
      {
