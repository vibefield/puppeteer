{
  "name": "puppeteer",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Native TUI coding-agent runtime: host agents' original terminal experiences with managed lifecycle, observation, and guarded control",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecook-dev/puppeteer.git"
  },
  "homepage": "https://github.com/vibecook-dev/puppeteer#readme",
  "bugs": {
    "url": "https://github.com/vibecook-dev/puppeteer/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm typecheck && pnpm packages:check && pnpm support:check && node --test scripts/*.test.mjs && pnpm -r test",
    "godview": "pnpm --filter godview start",
    "godview:bundle": "pnpm --filter godview bundle",
    "godview:smoke": "pnpm --filter godview smoke",
    "godview:appearance-smoke": "pnpm --filter godview appearance-smoke",
    "godview:restore-smoke": "pnpm --filter godview restore-smoke",
    "godview:test": "pnpm --filter godview test",
    "godview:typecheck": "pnpm --filter godview typecheck",
    "agent-devkit": "pnpm --filter imposter-control start",
    "agent-devkit:smoke": "pnpm --filter imposter-control smoke",
    "imposter-control": "pnpm agent-devkit",
    "imposter-control:smoke": "pnpm agent-devkit:smoke",
    "emulator": "pnpm agent-devkit",
    "emulator:smoke": "pnpm agent-devkit:smoke",
    "ai:link": "pnpm add --global ./packages/imposter",
    "surface:audit": "pnpm --filter @vibecook/puppeteer-surface run surface:audit",
    "packages:check": "node scripts/check-package-layout.mjs",
    "packages:clean": "node scripts/clean-packages.mjs",
    "support:check": "node scripts/render-agent-support.mjs --check",
    "support:write": "node scripts/render-agent-support.mjs --write",
    "upstream:check": "node scripts/detect-upstream-agents.mjs --check-config",
    "upstream:detect": "node scripts/detect-upstream-agents.mjs",
    "surface:detect": "pnpm upstream:detect",
    "surface:acquire": "node scripts/acquire-agent-artifacts.mjs",
    "surface:download": "node scripts/download-agent-artifact.mjs",
    "surface:evidence:artifacts": "node scripts/update-agent-evidence-artifacts.mjs",
    "surface:replay": "node scripts/replay-agent-surface.mjs",
    "surface:reconcile": "node scripts/reconcile-agent-surface.mjs",
    "surface:verify": "node scripts/verify-agent-surface.mjs",
    "surface:promote": "node scripts/promote-agent-surface.mjs",
    "pack:check": "pnpm build && node scripts/pack-check.mjs",
    "release:publish": "pnpm -r --filter './packages/**' typecheck && pnpm -r --filter './packages/**' test && pnpm -r --filter './packages/**' build && node scripts/publish-packages.mjs",
    "release:trust": "node scripts/trust-packages.mjs",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\""
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "@vibecook/puppeteer-surface": "workspace:*"
  }
}
