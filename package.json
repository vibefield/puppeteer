{
  "name": "puppeteer",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Native TUI coding-agent runtime: host agents' original terminal experiences with managed lifecycle, observation, and guarded control",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/puppeteer.git"
  },
  "homepage": "https://github.com/vibefield/puppeteer#readme",
  "bugs": {
    "url": "https://github.com/vibefield/puppeteer/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm typecheck && pnpm packages:check && pnpm view-wall:check && pnpm groundtruth:mapping:check && pnpm support:check && node --test scripts/*.test.mjs && pnpm -r --no-bail --workspace-concurrency=1 test --testTimeout=15000",
    "godview": "pnpm --filter godview start",
    "godview:local": "pnpm godview:local:build && pnpm --filter godview exec electron .",
    "godview:local:build": "npm --prefix ../electron-ghostty run build:sdk && pnpm godview:bundle",
    "godview:bundle": "pnpm --filter godview bundle",
    "godview:smoke": "pnpm --filter godview smoke",
    "godview:appearance-smoke": "pnpm --filter godview appearance-smoke",
    "godview:restore-smoke": "pnpm --filter godview restore-smoke",
    "godview:launcher-smoke": "pnpm --filter godview launcher-smoke",
    "godview:launcher-drive-smoke": "pnpm --filter godview launcher-drive-smoke",
    "godview:worker-windows-probe": "pnpm --filter godview worker-windows-probe",
    "godview:test": "pnpm --filter godview test",
    "godview:typecheck": "pnpm --filter godview typecheck",
    "agent-devkit": "pnpm --filter imposter-control start",
    "agent-devkit:smoke": "pnpm --filter imposter-control smoke",
    "ai:link": "pnpm add --global ./packages/imposter",
    "surface:audit": "pnpm --filter @vibefield/puppeteer-surface run surface:audit",
    "surface:groundtruth:check": "pnpm --filter @vibefield/puppeteer-surface run surface:groundtruth:check",
    "surface:groundtruth:write": "pnpm --filter @vibefield/puppeteer-surface run surface:groundtruth:write",
    "surface:groundtruth:render": "pnpm --filter @vibefield/puppeteer-surface run surface:groundtruth:render",
    "groundtruth:mapping:check": "node scripts/check-adapter-groundtruth-maps.mjs",
    "groundtruth:mapping:write": "node scripts/check-adapter-groundtruth-maps.mjs --write",
    "packages:check": "node scripts/check-package-layout.mjs && node scripts/check-portable-paths.mjs",
    "packages:clean": "node scripts/clean-packages.mjs",
    "view-wall:check": "node scripts/check-view-wall.mjs",
    "support:check": "node scripts/render-agent-support.mjs --check",
    "support:write": "node scripts/render-agent-support.mjs --write",
    "upstream:check": "node scripts/detect-upstream-agents.mjs --check-config",
    "upstream:detect": "node scripts/detect-upstream-agents.mjs",
    "surface:acquire": "node scripts/acquire-agent-artifacts.mjs",
    "surface:download": "node scripts/download-agent-artifact.mjs",
    "surface:materialize": "node scripts/materialize-installed-console.mjs",
    "surface:evidence:artifacts": "node scripts/update-agent-evidence-artifacts.mjs",
    "surface:replay": "node scripts/replay-agent-surface.mjs",
    "surface:reconcile": "node scripts/reconcile-agent-surface.mjs",
    "surface:verify": "node scripts/verify-agent-surface.mjs",
    "surface:promote": "node scripts/promote-agent-surface.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "release:check": "pnpm packages:check && node scripts/publish-packages.mjs --dry-run",
    "release:publish": "pnpm packages:check && pnpm -r --filter './packages/**' typecheck && pnpm -r --no-bail --workspace-concurrency=1 --filter './packages/**' test --testTimeout=15000 && node scripts/publish-packages.mjs",
    "release:trust": "node scripts/trust-packages.mjs",
    "release:trust:check": "node scripts/trust-packages.mjs --check",
    "release:verify": "node scripts/verify-published-packages.mjs",
    "release:verify:packed": "node scripts/pack-check.mjs --consumer",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.{ts,tsx,mjs}\" \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/*.{ts,mjs}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.{ts,tsx,mjs}\" \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/*.{ts,mjs}\" \"scripts/**/*.mjs\""
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3",
    "@vibefield/puppeteer-surface": "workspace:*"
  }
}
